<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MergeEntriesDialog</class>
 <widget class="QDialog" name="MergeEntriesDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>420</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Merge Entries</string>
  </property>
  <property name="modal">
   <bool>true</bool>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="descriptionLabel">
     <property name="text">
      <string>The selected entries are combined into a single entry. Attachments, tags, Auto-Type associations and a passkey are carried over where the entry you merge into has none of its own.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="targetLayout">
     <item>
      <widget class="QLabel" name="targetLabel">
       <property name="text">
        <string>Merge &amp;into:</string>
       </property>
       <property name="buddy">
        <cstring>targetComboBox</cstring>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="targetComboBox">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="toolTip">
        <string>The entry that is kept. All other selected entries are merged into it.</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="conflictsLabel">
     <property name="text">
      <string>Choose the value to keep for each field the entries disagree on:</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QTableWidget" name="conflictsTableWidget">
     <property name="editTriggers">
      <set>QAbstractItemView::NoEditTriggers</set>
     </property>
     <property name="selectionMode">
      <enum>QAbstractItemView::NoSelection</enum>
     </property>
     <property name="columnCount">
      <number>2</number>
     </property>
     <attribute name="horizontalHeaderStretchLastSection">
      <bool>true</bool>
     </attribute>
     <attribute name="verticalHeaderVisible">
      <bool>false</bool>
     </attribute>
     <column>
      <property name="text">
       <string>Field</string>
      </property>
     </column>
     <column>
      <property name="text">
       <string>Value to keep</string>
      </property>
     </column>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="unmergeableEntriesLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="noConflictsLabel">
     <property name="text">
      <string>The selected entries do not disagree on any field, so there is nothing to choose.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="concatenateNotesCheckBox">
     <property name="text">
      <string>Combine the notes of all entries</string>
     </property>
     <property name="toolTip">
      <string>Append the notes of the merged entries instead of keeping only one of them.</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="keepDiscardedValuesCheckBox">
     <property name="text">
      <string>Keep the values that are not kept as custom attributes</string>
     </property>
     <property name="toolTip">
      <string>Discarded URLs are always kept as additional URLs.</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="deleteMergedEntriesCheckBox">
     <property name="text">
      <string>Delete the merged entries afterwards</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
